{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "carRepairProductionDb",
    "ServiceOrderJobsCollectionName": "serviceOrderJobs"
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "car-repair.events",
    "DeadLetterExchangeName": "car-repair.events.dlx",
    "RetryCount": 3,
    "RetryDelayMilliseconds": 5000,
    "PrefetchCount": 10,
    "Durable": true
  },
  "AllowedHosts": "*"
}
